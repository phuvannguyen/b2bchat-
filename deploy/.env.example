# Copy to .env in the deploy folder on each server (e.g. ~/b2b-chat/.env) and fill in.
# This file is never committed with real values.

# Domain of this environment, e.g. staging.example.com or app.example.com.
# Point its DNS A record at the server before the first deploy.
DOMAIN=staging.example.com

# Long random values: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me

# File storage (any S3-compatible service).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
