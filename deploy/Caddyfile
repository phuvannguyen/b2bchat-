# DOMAIN comes from deploy/.env. Caddy obtains and renews the HTTPS certificate itself.
{$DOMAIN:localhost} {
	encode zstd gzip

	# REST API and realtime (WebSocket) traffic go to the API container.
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /socket.io/* {
		reverse_proxy api:3000
	}

	# Everything else is the web app (single-page app, so unknown paths fall back to index.html).
	handle {
		root * /srv
		@hashed path /_expo/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
